DATABASE_URL          # PostgreSQL bağlantı adresi (zorunlu)
JWT_SECRET            # Oturum çerezlerini imzalar (zorunlu)
PORT                  # Varsayılan 3001
NODE_ENV              # Canlıda MUTLAKA "production" — çerez secure/sameSite bayrakları buna bakıyor
FRONTEND_URL          # Sitenin adresi; iyzico dönüş yönlendirmeleri (canlıda zorunlu)
BACKEND_URL           # API'nin adresi; paket görsel URL'leri bununla kurulur (canlıda zorunlu)
IYZICO_API_KEY
IYZICO_SECRET_KEY
IYZICO_BASE_URL
# Cloudflare R2 (private bucket: galeri fotoğrafları + paket görselleri)
# Bucket PUBLIC OLMAMALI — erişim imzalı URL ve backend proxy üzerinden.
R2_ACCOUNT_ID         # Yalnız hesap ID'si (32 karakter) — tam endpoint URL'si DEĞİL
R2_ACCESS_KEY_ID      # R2 API token Access Key (32 karakter)
R2_SECRET_ACCESS_KEY  # R2 API token Secret (64 karakter)
R2_BUCKET             # Bucket'ın ADI (ör. rngsport) — URL değil
# Resend (transactional e-posta: doğrulama, şifre sıfırlama, teslimat bildirimi)
RESEND_API_KEY
MAIL_FROM
