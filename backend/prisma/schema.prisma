generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Order {
  id              String      @id @default(cuid())
  athleteName     String
  clubName        String
  birthYear       String
  customerPhone   String
  customerEmail   String?
  notes           String?
  totalPrice      Float // Ödenecek son tutar (indirim düşülmüş)
  subtotal        Float? // İndirimsiz tutar (sadakat sisteminden önceki kayıtlarda null)
  discountPercent Int         @default(0) // Oluşturma anında sabitlenen seviye indirimi
  discountAmount  Float       @default(0)
  redeemPoints    Int         @default(0) // İndirim için harcanan seviye puanı (rezervasyonda oluşturunca, siparişte ödeyince düşer)
  status          OrderStatus @default(PENDING)
  paymentId       String?
  conversationId  String?
  // Çekim listesi alanları
  expectedTime    String? // Excel'den gelecek beklenen çıkış saati ("14:23" gibi)
  shootStartedAt  DateTime? // Çekimin gerçek başlangıç saati
  shootEndedAt    DateTime? // Çekimin gerçek bitiş saati
  userId          String? // Girişli kullanıcı sipariş verdiyse bağlanır
  locale          String      @default("tr") // Siparişin verildiği dil — mailler bu dilde gider
  deliveries      Json? // Parça parça teslim: { photo, video, reels, general } → ISO tarih (mail bir kez gider)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               OrderItem[]
  shootingListEntries ShootingListEntry[]

  @@index([userId])
  @@map("orders")
}

model OrderItem {
  id          String   @id @default(cuid())
  orderId     String
  packageId   String
  packageName String
  category    String
  price       Float
  seriesCount Int
  quantity    Int
  apparatuses String[] @default([]) // Bu paket satırı için seçilen aletler (length === seriesCount)
  points      Int      @default(0) // Satış anındaki sadakat puanı (paket puanı × seri × adet)
  priority    Boolean  @default(false) // Öncelikli seçildi mi (ücret price içinde)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("order_items")
}

enum OrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  DELIVERED
}

model User {
  id                   String    @id @default(cuid())
  username             String?   @unique // Admin girişi için (müşterilerde null)
  email                String?   @unique // Müşteri girişi için (lowercase saklanır)
  password             String? // null = sipariş/rezervasyonla otomatik açıldı, şifre henüz belirlenmedi
  // Sporcu bilgileri — rezervasyon formunun ön-doldurması ve galeri klasörü bunlardan gelir
  name                 String? // Sporcu adı soyadı
  clubName             String?
  birthYear            String? // Proje genelinde serbest metin (Order/Reservation'da da String)
  phone                String?
  role                 String    @default("customer")
  // E-posta doğrulama + şifre sıfırlama (token'lar sha256 hash olarak saklanır)
  emailVerifiedAt      DateTime?
  verifyTokenHash      String?
  verifyTokenExpiresAt DateTime?
  resetTokenHash       String?
  resetTokenExpiresAt  DateTime?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  photos       GalleryPhoto[]
  orders       Order[]
  reservations Reservation[]
  points       PointTransaction[]
  shopOrders   ShopOrder[]

  @@map("users")
}

model GalleryPhoto {
  id          String   @id @default(cuid())
  userId      String
  r2Key       String   @unique // R2 object key: users/{userId}/{uuid}.{ext}
  fileName    String // Orijinal dosya adı (indirme için)
  album       String? // Opsiyonel çekim/albüm etiketi
  size        Int?
  contentType String?
  // Önizlemeler (tarayıcı yüklerken üretir; eski kayıtlarda boş → orijinal gösterilir)
  thumbKey    String? // ızgara küçük resmi (~480px)
  previewKey  String? // büyük görünüm + "telefon için" indirme (~2048px)
  previewSize Int?
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("gallery_photos")
}

model Package {
  id                   String   @id @default(cuid())
  slug                 String   @unique // photo-basic, video-full gibi
  name                 String
  category             String // photo, video, full
  price                Float
  image                String
  features             String[] // PostgreSQL array
  discount2            Float // 2 seri indirimi
  discount3            Float // 3 seri indirimi
  // Rezervasyon fiyatları (elden nakit için)
  reservationPrice     Float? // Rezervasyon baz fiyatı (null ise price kullanılır)
  reservationDiscount2 Float? // 2 seri rezervasyon fiyatı
  reservationDiscount3 Float? // 3 seri rezervasyon fiyatı
  loyaltyPoints        Int      @default(0) // Sadakat puanı (seri başına; × seri × adet)
  priorityFee          Float? // Öncelikli ek ücreti (seri başına); null = bu pakette öncelik seçilemez
  translations         Json? // Çeviriler: { en: { name, features }, ru: {...} } — boş alan Türkçeye düşer
  isActive             Boolean  @default(true)
  sortOrder            Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("packages")
}

model Reservation {
  id              String            @id @default(cuid())
  athleteName     String
  clubName        String
  birthYear       String
  customerPhone   String
  customerEmail   String
  notes           String?
  totalPrice      Float // Ödenecek son tutar (indirim düşülmüş)
  subtotal        Float? // İndirimsiz tutar (sadakat sisteminden önceki kayıtlarda null)
  discountPercent Int               @default(0) // Oluşturma anında sabitlenen seviye indirimi
  discountAmount  Float             @default(0)
  redeemPoints    Int               @default(0) // İndirim için harcanan seviye puanı (rezervasyonda oluşturunca, siparişte ödeyince düşer)
  status          ReservationStatus @default(PENDING)
  // Çekim listesi alanları
  expectedTime    String?
  shootStartedAt  DateTime?
  shootEndedAt    DateTime?
  userId          String? // Girişli kullanıcı rezervasyon yaptıysa bağlanır
  locale          String            @default("tr") // Rezervasyonun yapıldığı dil — mailler bu dilde gider
  deliveries      Json? // Parça parça teslim: { photo, video, reels, general } → ISO tarih (mail bir kez gider)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  user                User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  items               ReservationItem[]
  shootingListEntries ShootingListEntry[]

  @@index([userId])
  @@map("reservations")
}

model ReservationItem {
  id            String   @id @default(cuid())
  reservationId String
  packageId     String
  packageName   String
  category      String
  price         Float
  seriesCount   Int
  quantity      Int
  apparatuses   String[] @default([]) // Bu paket satırı için seçilen aletler (length === seriesCount)
  points        Int      @default(0) // Satış anındaki sadakat puanı (paket puanı × seri × adet)
  priority      Boolean  @default(false) // Öncelikli seçildi mi (ücret price içinde)

  reservation Reservation @relation(fields: [reservationId], references: [id], onDelete: Cascade)

  @@map("reservation_items")
}

enum ReservationStatus {
  PENDING
  CONFIRMED
  PAID
  CANCELLED
  DELIVERED
}

model Tournament {
  id           String   @id @default(cuid())
  name         String
  date         String // Serbest metin: "18-21 Haziran 2026" (aralıklar için tarih tipi uygun değil)
  location     String
  flag         String? // /flags/tr.svg gibi public yolu (null = bayrak gösterilmez)
  flagAlt      String?
  status       String   @default("upcoming") // finished | ongoing | upcoming
  translations Json? // { en: { name, date, location, flagAlt }, ru: {...} }
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("tournaments")
}

model ShootingDay {
  id        String   @id @default(cuid())
  label     String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  entries ShootingListEntry[]

  @@map("shooting_days")
}

model ShootingListEntry {
  id                  String    @id @default(cuid())
  dayId               String
  position            Int
  athleteName         String
  clubName            String?
  birthYear           String?
  category            String?
  expectedTime        String?
  // Eşleşme bayrakları: willBeShot = herhangi bir paket; diğerleri iz (track) bazlı
  willBeShot          Boolean   @default(false)
  willBeShotPhoto     Boolean   @default(false) // photo + full paketler
  willBeShotVideo     Boolean   @default(false) // video + full paketler
  orderId             String?
  reservationId       String?
  // Foto ve video ekibi ayrı saat tutar; @map ile eski kolon adları korunur (veri kaybı yok)
  photoStartedAt      DateTime? @map("shootStartedAt")
  photoEndedAt        DateTime? @map("shootEndedAt")
  videoStartedAt      DateTime?
  videoEndedAt        DateTime?
  // Foto klasör numarası elle düzeltildiyse (boş = otomatik: günün foto çekim sırası, 100'den)
  photoFolderOverride Int?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  day         ShootingDay  @relation(fields: [dayId], references: [id], onDelete: Cascade)
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  reservation Reservation? @relation(fields: [reservationId], references: [id], onDelete: SetNull)

  @@index([dayId])
  @@index([position])
  @@map("shooting_list_entries")
}

// Herkese açık ödül töreni galerileri (/odul-torenleri). Müşteri galerisinden
// bağımsız: fotoğraflar kişiye değil törene bağlı, giriş gerekmeden görüntülenir.
model AwardCeremony {
  id           String   @id @default(cuid())
  slug         String   @unique // URL: /odul-torenleri/{slug}
  title        String
  description  String?
  date         String? // Serbest metin: "12 Ekim 2026"
  location     String?
  translations Json? // { en: { title, description, date, location }, ru: {...} }
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  photos AwardPhoto[]

  @@map("award_ceremonies")
}

model AwardPhoto {
  id          String   @id @default(cuid())
  ceremonyId  String
  r2Key       String   @unique // odul-torenleri/{slug}_{ceremonyId}/{uuid}.{ext}
  fileName    String
  size        Int?
  contentType String?
  // Önizlemeler (bkz. GalleryPhoto)
  thumbKey    String?
  previewKey  String?
  previewSize Int?
  createdAt   DateTime @default(now())

  ceremony AwardCeremony @relation(fields: [ceremonyId], references: [id], onDelete: Cascade)

  @@index([ceremonyId])
  @@map("award_photos")
}

// Sadakat puan defteri. Bakiye = amount toplamı. Kaynak (rezervasyon/sipariş) FK
// DEĞİL, düz metin: yarışma sonrası kayıtlar silinse de puan geçmişi kalır.
model PointTransaction {
  id          String   @id @default(cuid())
  userId      String
  amount      Int // + kazanım, − geri alma / düşüş
  type        String // EARN | REVERSE | REDEEM | REFUND | ADJUST
  sourceType  String? // reservation | order (ADJUST'ta null)
  sourceId    String?
  note        String?
  createdById String? // ADJUST'u yapan admin
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([sourceType, sourceId])
  @@map("point_transactions")
}

// Sadakat seviyeleri — toplam puan minPoints'e ulaşınca discountPercent indirim
model LoyaltyTier {
  id              String   @id @default(cuid())
  name            String
  minPoints       Int      @unique
  discountPercent Int
  translations    Json? // { en: { name }, ru: { name } }
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("loyalty_tiers")
}

// --- Mağaza: kişiye özel ürünler (paket siparişlerinden tamamen ayrı) ---------------

model ShopProduct {
  id           String   @id @default(cuid())
  slug         String   @unique // URL: /urunler/{slug}; mevcut iki ürünün tanıtım metni data/products.ts'te slug ile eşleşir
  name         String
  tagline      String?
  summary      String? // Kartlardaki kısa açıklama
  description  String? // Detay sayfası metni (paragraflar boş satırla ayrılır)
  price        Float? // null = fiyat girilmemiş → satın alınamaz
  image        String? // R2 "urunler/{uuid}.{ext}" ya da eski "/products/*.jpeg"
  customFields Json? // Kişiselleştirme alanları: [{ key, label, required, maxLength }]
  poseOptions  Json? // Alet → poz seçimi: { enabled, apparatuses: [{ slug, enabled, poses: [{ no, image, label }] }] }
  translations Json? // { en: { name, tagline, summary, description, fields: { key: label } }, ru: {...} }
  isActive     Boolean  @default(false)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  orders ShopOrder[]

  @@map("shop_products")
}

model ShopOrder {
  id              String          @id @default(cuid())
  userId          String? // Hesap silinse de sipariş kaydı kalır (SetNull)
  productId       String?
  // Satış anındaki ürün bilgisi (ürün sonradan değişse/silinse de sipariş bozulmasın)
  productName     String
  productSlug     String
  unitPrice       Float
  quantity        Int             @default(1)
  totalPrice      Float
  personalization Json // { alanKey: değer } — ileride fotoğraf anahtarları da buraya
  fieldLabels     Json? // Sipariş anındaki alan adları { alanKey: "Sporcu adı" }
  selection       Json? // Seçilen alet + poz: { apparatus, poseNo, poseLabel, poseImage } (sipariş anındaki kopya)
  // Teslimat
  recipientName   String
  phone           String
  city            String
  district        String
  address         String
  postalCode      String?
  customerNote    String?
  // Admin
  trackingInfo    String? // Kargo firması + takip no (müşteri görür)
  adminNote       String? // Yalnızca admin görür
  status          ShopOrderStatus @default(PENDING)
  paymentId       String?
  conversationId  String?
  paidAt          DateTime?
  shippedAt       DateTime?
  deliveredAt     DateTime?
  locale          String          @default("tr")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  user    User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  product ShopProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@map("shop_orders")
}

enum ShopOrderStatus {
  PENDING // Ödeme bekleniyor
  FAILED // Ödeme başarısız
  CONFIRMED // Onaylandı (ödeme alındı)
  IN_PRODUCTION // Hazırlanıyor
  SHIPPED // Kargoda
  DELIVERED // Teslim edildi
  CANCELLED // İptal
}
